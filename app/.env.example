DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=tu-ip-o-dominio
DJANGO_CSRF_TRUSTED=https://tu-dominio
# True cuando Nginx ya sirve el sitio por HTTPS (certbot): activa cookies
# seguras, redirección a HTTPS y HSTS.
DJANGO_HTTPS=False
DB_ENGINE=postgres
DB_NAME=smileesync
DB_USER=smileesync
DB_PASSWORD=clave-segura
DB_HOST=localhost
DB_PORT=5432
