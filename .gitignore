# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Django
*.sqlite3
db.sqlite3
staticfiles/
media/
.env
*.log

# Modelos entrenados grandes / datos
ml/data/*.csv
ml/models/*.joblib

# CDK
infra/cdk.out/
infra/.venv/

# SO / editor
.DS_Store
.idea/
.vscode/

# Llaves y secretos (nunca subir)
*.pem
*.key
*.ppk

# Modelos entrenados por "manage.py entrenar": se regeneran y pesan varios MB.
app/modelos/

# Entregas del documento de graduación. No se versionan: pesan decenas de MB,
# cambian por completo en cada revisión y el historial de un .docx no se puede
# leer en un diff. El respaldo son OneDrive y la plataforma de la universidad.
docs/*.docx
docs/*.pdf

# Cobertura
.coverage
.coverage.*
htmlcov/

# Resultados locales de pruebas
junit.xml
coverage.xml

# Clave secreta generada para desarrollo local
app/.clave-desarrollo

# Entregables generados a partir del Markdown (docs/herramientas/generar_docx.py)
docs/entregables/

# Datos de infraestructura y credenciales: nunca se versionan
claude/
infra/cdk.context.json

# Evidencia de las sesiones de prueba con usuarios finales: fotografías y fichas
# firmadas. Contienen imágenes y firmas de personas; viven en el documento.
docs/evidencias/*.jpg
docs/evidencias/paginas/
docs/evidencias/sesiones/

# Notas de continuidad del documento
docs/herramientas/ONBOARDING.md
