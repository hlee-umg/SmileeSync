# Modelos entrenados por "manage.py entrenar": se regeneran y pesan varios MB.
app/modelos/

# Entregas del documento de graduación. No se versionan: pesan decenas de MB,
# cambian por completo en cada revisión y el historial de un .docx no se puede
# leer en un diff. El respaldo son OneDrive y la plataforma de la universidad.
docs/*.docx
docs/*.pdf

# Cobertura
.coverage
.coverage.*
htmlcov/

# Resultados locales de pruebas
junit.xml
coverage.xml

# Clave secreta generada para desarrollo local
app/.clave-desarrollo
