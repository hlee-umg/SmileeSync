    namespace SeguridadYUsuarios {
        class Rol {
            +String nombre
            +String descripcion
            +bool puede_usuarios
            +bool puede_pacientes
            +bool puede_catalogos
            +bool puede_agenda
            +bool puede_inteligencia
            +bool puede_reportes
            +bool estado
            +DateTime creado
        }
        class Usuario {
            +String email
            +String username
            +String first_name
            +String last_name
            +String telefono
            +String pregunta_secreta
            +String respuesta_secreta
            +bool estado
            +es_admin() bool
            +puede(modulo) bool
            +set_respuesta_secreta(texto)
            +check_respuesta_secreta(texto) bool
        }
        class HistorialUsuario {
            +int usuario_ref
            +String username
            +String nombre_completo
            +String email
            +String rol
            +bool estado_anterior
            +String accion
            +String realizado_por
            +DateTime fecha
            +registrar(usuario, accion, por)
        }
    }

